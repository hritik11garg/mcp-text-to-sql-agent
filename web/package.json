{
  "name": "text-to-sql-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo UI over POST /v1/query -- renders the SSE stream as it arrives.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run verify:csp",
    "verify:csp": "node scripts/assert-no-inline-assets.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "fast-check": "4.9.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
