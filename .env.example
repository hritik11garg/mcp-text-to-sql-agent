# Copy to .env and fill in. NEVER commit .env -- it is gitignored.
# Full reference with defaults and ceilings: docs/operations/CONFIG.md

# --- Postgres container (docker-compose) -----------------------------------
POSTGRES_USER=t2sql_owner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=analytics
POSTGRES_PORT=5432

# --- Database --------------------------------------------------------------
# Two roles, deliberately. DATABASE_RO_URL must resolve to a SELECT-only role;
# if it does not, every containment guarantee in SECURITY.md is void while
# everything still appears to work. Startup refuses to run if they are equal.
DATABASE_URL=postgresql+psycopg://t2sql_owner:change-me-locally@localhost:5432/analytics
DATABASE_RO_URL=postgresql://sql_agent_login:change-me-too@localhost:5432/analytics

# Password for the read-only login role, consumed by migration 002.
SQL_AGENT_RO_PASSWORD=change-me-too

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# Total simultaneous queries against the database is replicas x DB_POOL_MAX_SIZE.
# Size it against the DATABASE's capacity, not the application's -- scaling
# replicas without accounting for this scales load onto one database.
# See DEPLOYMENT.md section 7.
DB_CONNECT_TIMEOUT_MS=5000
# One schema. The benchmark loader creates one PER DATABASE
# (spider_concert_singer, ...), so evaluating across a corpus means setting
# this per run until the harness drives it per question.
DB_TARGET_SCHEMA=public
# The group role migration 002 creates. The benchmark loader grants SELECT on
# the schemas it creates to this role -- migration 002 grants on `public` only,
# so a converted schema is invisible to the agent until it is granted.
DB_READONLY_ROLE=sql_agent_ro

# --- LLM -------------------------------------------------------------------
# The agent depends on the LLMClient protocol, not on a vendor SDK (ADR-014).
# LLM_BASE_URL is OPERATOR-ONLY configuration. Never populate it from a
# request, header, or database value -- that turns this service into an SSRF
# primitive with the API key attached. See SECURITY.md section 14.1.
#
# Working endpoints (verify current free-tier terms yourself):
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1     (no key, fully offline)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# The default (16000) is above some free tiers' completion cap and the request
# is refused with HTTP 413 before the model runs. Measured on Groq with
# openai/gpt-oss-120b: 6000 accepted, 8192 refused. Too low is also a failure --
# a reasoning model spends the whole budget thinking and returns nothing.
LLM_MAX_TOKENS=4096

# 0.0 for reproducibility. An eval number produced at a non-zero temperature is
# not comparable to one produced at zero, and neither is comparable twice.
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_MS=60000

# Models to try, in order, when LLM_MODEL is out of quota. Same provider, same
# key -- a model chain, not a provider chain.
#
# READ THIS BEFORE SETTING IT FOR A BENCHMARK RUN. A fallback makes the run a
# BLEND: a measured run switched mid-way and reported 75.3%, which was 96% from
# one model and 59% from the other averaged together, a score neither earned.
# The harness reports `answered_by` and `single_model` and warns, but the only
# fix is to leave this empty when the number matters. See BENCHMARKS.md section 2.
# LLM_MODEL_FALLBACKS=llama-3.3-70b-versatile,qwen/qwen3.6-27b

# Optional host allowlist, applied on top of the IP checks. Empty means "any
# host that passes those checks". Defence in depth against operator error only
# -- the primary control is that LLM_BASE_URL is never populated from request
# data. See SECURITY.md section 14.1.
# LLM_ALLOWED_HOSTS=api.groq.com

# --- Schema retrieval ------------------------------------------------------
DATASET=default

# sentence_transformer is the real linker. "hashing" is a dependency-free
# stand-in for tests and offline work -- it has no semantic understanding, and
# its model_version says so, so a catalog indexed with it cannot be searched
# with a real model by accident.
EMBEDDER_PROVIDER=sentence_transformer
RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Refuse to download the model. Set true in CI and air-gapped deployments so an
# implicit network fetch fails loudly instead of succeeding.
RETRIEVER_LOCAL_FILES_ONLY=false

# LEAVE THIS OFF unless you have audited every column in the schema.
# Sampling copies real rows into the catalog, and the catalog is quoted into
# prompts sent to a third-party model -- a path the read-only role does not
# protect, because the data is read legitimately and then transmitted.
# See SECURITY.md section 14.2 (OWASP LLM06).
SCHEMA_SAMPLE_VALUES=false
SCHEMA_SAMPLE_COUNT=3
SCHEMA_SAMPLE_MAX_CHARS=40
SCHEMA_SAMPLE_SCAN_LIMIT=1000
# Comma-separated extra column-name substrings that must never be sampled.
# Added to the built-in list, never replacing it, so configuration can only
# tighten. NOT JSON -- an earlier version of this line showed JSON, which
# splits on the commas into '["internal_ref"' and '"account_alias"]' and
# silently gives you a denylist that matches nothing.
# SCHEMA_EXTRA_SENSITIVE_COLUMNS=internal_ref,account_alias

# Catalog elements returned per search. This is the single highest-leverage
# knob in the system: on Spider, k=10 scored 42.7% and k=30 scored 72.7% with
# no other change, because a schema the model cannot see is a question it
# correctly refuses to answer.
#
# 10 is a DEPLOYMENT default, sized for a real schema where 30 elements is a
# large prompt and a real cost. It is deliberately NOT tuned for benchmarks:
# a Spider database holds 26 elements on average, so retrieving 30 of 26 is
# not retrieval, it is the full-schema baseline wearing retrieval's name.
# Benchmark runs pass `--top-k` per run instead. See BENCHMARKS.md section 2.
RETRIEVAL_TOP_K=10
# HNSW search breadth: higher is more accurate and slower. Swept in Stage 6.
HNSW_EF_SEARCH=40

# --- Execution limits ------------------------------------------------------
MAX_ROWS_DEFAULT=500
MAX_ROWS_CEILING=5000
STATEMENT_TIMEOUT_MS=30000
STATEMENT_TIMEOUT_CEILING_MS=60000

# Planner cost ceiling, checked by EXPLAIN BEFORE a query runs, so an expensive
# query is refused rather than timed out.
#
# CALIBRATE THIS FOR YOUR DATABASE. Cost units are not seconds and do not
# transfer between machines or datasets. The default suits benchmark-sized data
# (thousands of rows); on a warehouse with millions, an ordinary analytical
# join exceeds it and legitimate questions get refused with `cost_exceeded`.
# Procedure: EXPLAIN the slowest query you consider acceptable, take its
# Total Cost, add headroom. See CONFIG.md section 4.
MAX_ESTIMATED_COST=1000000

# --- Table profiling -------------------------------------------------------
# Profiling is the one component whose OUTPUT IS ROW DATA BY DESIGN. Every
# default here assumes the target database holds real customer records and the
# operator has not read this file. Three independent gates, not one.
# See SECURITY.md section 14.2.6.
#
# Gate 1: raw sampled rows. LEAVE THIS OFF unless you have audited the schema.
# Statistics answer "is this the column I want?"; raw rows answer "what do the
# values look like?", which is occasionally necessary and always a disclosure.
PROFILE_ALLOW_VALUE_SAMPLING=false
PROFILE_SAMPLE_ROWS=5
# Gate 2: a small-cell threshold, the standard statistical-disclosure control.
# A value seen once is a record; a value seen many times is a category. Withheld
# even when sampling is on. Can be raised, never lowered to 1.
PROFILE_MIN_VALUE_FREQUENCY=5
# Gate 3 is the built-in sensitive-column denylist, extended by
# SCHEMA_EXTRA_SENSITIVE_COLUMNS above.
#
# The rest are cost and context bounds. Lowering them is safe in both
# directions; RAISING THEM IS A SECURITY CHANGE, because they are also the
# disclosure bounds.
PROFILE_SCAN_LIMIT=5000
PROFILE_MAX_COLUMNS=30
PROFILE_MAX_VALUE_CHARS=40
PROFILE_TOP_K=5
# Deliberately shorter than the executor's timeout: profiling is a side quest
# during answering and should give up long before the real query would.
PROFILE_TIMEOUT_MS=10000

# --- Agent budgets ---------------------------------------------------------
# Not optional. An agent that fails to converge retries until something stops
# it, and that something must be a counter rather than a hope.
MAX_TOOL_CALLS_PER_REQUEST=20
MAX_SQL_RETRIES=3
MAX_DECOMPOSITION_STEPS=5
# Whole-request budget. Bounds a request that is slow for a reason no single
# per-call timeout catches -- many cheap calls rather than one expensive one.
AGENT_TIMEOUT_MS=120000

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# Leave off. Logging result values copies the data the read-only role protects
# into a second store with different retention and access controls.
LOG_RESULT_VALUES=false

# --- Benchmark loader ------------------------------------------------------
# Read only by `python -m benchmark.load`. Nothing here is reachable from a
# request. The byte caps are enforced against bytes WRITTEN, never against the
# sizes an archive declares about itself -- a zip's own directory is
# attacker-controlled. See CONFIG.md section 5b and SECURITY.md 14.2.9.
BENCHMARK_DATA_DIR=data
# BENCHMARK_MAX_ARCHIVE_BYTES=8589934592
# BENCHMARK_MAX_ARCHIVE_MEMBERS=200000
# BENCHMARK_MAX_MEMBER_BYTES=4294967296
# BENCHMARK_COPY_BATCH_ROWS=5000
# BENCHMARK_VERIFY_TIMEOUT_MS=30000
