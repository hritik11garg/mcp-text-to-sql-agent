# Copy to .env and fill in. NEVER commit .env -- it is gitignored.
# Full reference with defaults and ceilings: docs/operations/CONFIG.md

# --- Postgres container (docker-compose) -----------------------------------
POSTGRES_USER=t2sql_owner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=analytics
POSTGRES_PORT=5432

# --- Database --------------------------------------------------------------
# Two roles, deliberately. DATABASE_RO_URL must resolve to a SELECT-only role;
# if it does not, every containment guarantee in SECURITY.md is void while
# everything still appears to work. Startup refuses to run if they are equal.
DATABASE_URL=postgresql+psycopg://t2sql_owner:change-me-locally@localhost:5432/analytics
DATABASE_RO_URL=postgresql://sql_agent_login:change-me-too@localhost:5432/analytics

# Password for the read-only login role, consumed by migration 002.
SQL_AGENT_RO_PASSWORD=change-me-too

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TARGET_SCHEMA=public

# --- LLM -------------------------------------------------------------------
# The agent depends on the LLMClient protocol, not on a vendor SDK (ADR-014).
# LLM_BASE_URL is OPERATOR-ONLY configuration. Never populate it from a
# request, header, or database value -- that turns this service into an SSRF
# primitive with the API key attached. See SECURITY.md section 14.1.
#
# Working endpoints (verify current free-tier terms yourself):
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1     (no key, fully offline)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# --- Schema retrieval ------------------------------------------------------
DATASET=default

# sentence_transformer is the real linker. "hashing" is a dependency-free
# stand-in for tests and offline work -- it has no semantic understanding, and
# its model_version says so, so a catalog indexed with it cannot be searched
# with a real model by accident.
EMBEDDER_PROVIDER=sentence_transformer
RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Refuse to download the model. Set true in CI and air-gapped deployments so an
# implicit network fetch fails loudly instead of succeeding.
RETRIEVER_LOCAL_FILES_ONLY=false

# LEAVE THIS OFF unless you have audited every column in the schema.
# Sampling copies real rows into the catalog, and the catalog is quoted into
# prompts sent to a third-party model -- a path the read-only role does not
# protect, because the data is read legitimately and then transmitted.
# See SECURITY.md section 14.2 (OWASP LLM06).
SCHEMA_SAMPLE_VALUES=false
SCHEMA_SAMPLE_COUNT=3
SCHEMA_SAMPLE_MAX_CHARS=40
SCHEMA_SAMPLE_SCAN_LIMIT=1000
# JSON list of extra column-name substrings that must never be sampled. Added
# to the built-in list, never replacing it, so configuration can only tighten.
# SCHEMA_EXTRA_SENSITIVE_COLUMNS=["internal_ref","account_alias"]

# --- Execution limits ------------------------------------------------------
MAX_ROWS_DEFAULT=500
MAX_ROWS_CEILING=5000
STATEMENT_TIMEOUT_MS=30000
STATEMENT_TIMEOUT_CEILING_MS=60000

# --- Agent budgets ---------------------------------------------------------
MAX_TOOL_CALLS_PER_REQUEST=20
MAX_SQL_RETRIES=3

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# Leave off. Logging result values copies the data the read-only role protects
# into a second store with different retention and access controls.
LOG_RESULT_VALUES=false
